# DHRUVA Environment Profile Template
ENV=qa
BASE_URL=https://qa.example.com
CLIENT_NAME=Default Enterprise Client
APPLICATION_NAME=Core Web Platform

# Cloud Storage Configuration (Optional)
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=dhruva-qa-artifacts-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Application Credentials (Injected from CI Secrets in pipeline)
ADMIN_USER_EMAIL=admin@example.com
ADMIN_USER_PASSWORD=SampleSecurePassword123!

# Notification Webhooks (Optional)
SLACK_WEBHOOK_URL=
MS_TEAMS_WEBHOOK_URL=
